@inherits LiveComponent

@* The pack's jobs, newest first, one server page at a time. *@
<MudTable T="Job" @ref="_table" ServerData="LoadPageAsync" Dense="true" Hover="true" Elevation="0" RowsPerPage="25">
    <HeaderContent>
        <MudTh>Created</MudTh><MudTh>Job</MudTh><MudTh>State</MudTh><MudTh Style="width: 12rem">Progress</MudTh><MudTh>Error</MudTh><MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
        <MudTd>@context.Kind @context.Operation</MudTd>
        <MudTd><MudChip T="string" Size="Size.Small" Color="@StateColor(context.State)">@context.State</MudChip>@(context.Attempt > 1 ? $" (attempt {context.Attempt})" : "")</MudTd>
        <MudTd>
            @if (context.State == JobState.Running)
            {
                <MudProgressLinear Value="@((context.Progress ?? 0) * 100)" Indeterminate="@(context.Progress is null)" Color="Color.Primary" />
            }
        </MudTd>
        <MudTd Class="pre-wrap" Style="max-width: 36rem">@context.Error</MudTd>
        <MudTd>
            @if (context.State is JobState.Queued or JobState.Running)
            {
                <MudButton Size="Size.Small" OnClick='() => Act(context, "cancel")'>Cancel</MudButton>
            }
            else if (context.State is JobState.Failed or JobState.Cancelled)
            {
                <MudButton Size="Size.Small" OnClick='() => Act(context, "retry")'>Retry</MudButton>
            }
        </MudTd>
    </RowTemplate>
    <PagerContent><MudTablePager PageSizeOptions="@([10, 25, 50])" /></PagerContent>
</MudTable>

@code {
    [Parameter, EditorRequired] public Guid PackId { get; set; }
    private MudTable<Job>? _table;
    private List<Job> _page = [];

    private async Task<TableData<Job>> LoadPageAsync(TableState state, CancellationToken ct)
    {
        try
        {
            var page = await Api.GetAsync<Page<Job>>($"api/packs/{PackId}/jobs?skip={state.Page * state.PageSize}&take={state.PageSize}");
            _page = page.Items;
            return new TableData<Job> { Items = page.Items, TotalItems = page.Total };
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); return new TableData<Job> { Items = [], TotalItems = 0 }; }
    }

    protected override Task LoadAsync() => _table?.ReloadServerData() ?? Task.CompletedTask;

    protected override bool Concerns(Guid? packId, Guid? assetId) => packId == PackId;

    protected override Task OnJobEventAsync(JobEventMessage e)
    {
        if (e.Type == "stream") return Task.CompletedTask;
        if (e.Type == "progress" && _page.FirstOrDefault(j => j.Id == e.JobId) is { } job)
        {
            job.Progress = e.Data?["progress"]?.GetValue<double?>();
            job.State = e.State;
            return Task.CompletedTask;
        }
        return LoadAsync();
    }

    public static Color StateColor(JobState state) => state switch
    {
        JobState.Succeeded => Color.Success,
        JobState.Failed => Color.Error,
        JobState.Running => Color.Info,
        JobState.Cancelled => Color.Dark,
        _ => Color.Default,
    };

    private Task Act(Job job, string action) => Try(() => Api.PostAsync<Job>($"api/jobs/{job.Id}/{action}"));
}
