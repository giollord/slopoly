@* Pick / reject / undecided / delete buttons of one concept image (gallery cards and the concept page), plus "Make
   views" on a picked hero. Views have no selection of their own: they follow their hero. *@
@inject StudioApi Api
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

@if (Concept.Kind == ConceptKind.Hero && Concept.Selection == Selection.Picked)
{
    <MudTooltip Text="Make views (front, side, top, back) from a 3D splat of this hero">
        <MudIconButton Icon="@Icons.Material.Filled.ViewInAr" Color="Color.Primary" OnClick="MakeViewsAsync" />
    </MudTooltip>
}
@if (Concept.Kind != ConceptKind.View)
{
    <MudTooltip Text="Pick"><MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="@(Concept.Selection == Selection.Picked ? Color.Success : Color.Default)" OnClick="() => SelectAsync(Selection.Picked)" /></MudTooltip>
    <MudTooltip Text="Reject (hidden from the agent)"><MudIconButton Icon="@Icons.Material.Filled.Cancel" Color="@(Concept.Selection == Selection.Rejected ? Color.Error : Color.Default)" OnClick="() => SelectAsync(Selection.Rejected)" /></MudTooltip>
    <MudTooltip Text="Undecided"><MudIconButton Icon="@Icons.Material.Filled.RadioButtonUnchecked" OnClick="() => SelectAsync(Selection.None)" /></MudTooltip>
}
<MudTooltip Text="Delete"><MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync" /></MudTooltip>

@code {
    [Parameter, EditorRequired] public ConceptImage Concept { get; set; } = null!;
    [Parameter] public EventCallback OnDeleted { get; set; }

    private async Task SelectAsync(Selection selection)
    {
        try { await Api.PutAsync<ConceptImage>($"api/concepts/{Concept.Id}/selection", new SelectionEdit(selection)); }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task MakeViewsAsync()
    {
        try
        {
            await Api.PostAsync<Job>($"api/concepts/{Concept.Id}/views", new ViewsRequest());
            Snackbar.Add("Views queued (about a minute); they appear under the hero.", Severity.Info);
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteAsync()
    {
        var what = Concept.Kind == ConceptKind.Hero ? "this hero, its views and their part masks" : "this concept image and its part masks";
        if (await Dialogs.ShowMessageBoxAsync("Delete image", $"Delete {what}? This can't be undone.",
                yesText: "Delete", cancelText: "Cancel") != true) return;
        try
        {
            await Api.DeleteAsync($"api/concepts/{Concept.Id}");
            await OnDeleted.InvokeAsync();
        }
        catch (ApiException ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
