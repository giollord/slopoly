@using MudBlazor.Utilities

@* A compact #rrggbb colour picker (MudColorPicker without alpha) with a swatch. *@
<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
    <span class="swatch" style="background: @Value"></span>
    <div class="color-field">
        <MudColorPicker Value="@(new MudColor(Value))" ValueChanged="OnChanged" ShowAlpha="false" Editable="true" ColorPickerMode="ColorPickerMode.HEX"
                        Variant="Variant.Outlined" Margin="Margin.Dense" />
    </div>
</MudStack>

@code {
    [Parameter] public string Value { get; set; } = "#808080";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    private Task OnChanged(MudColor color)
    {
        var hex = $"#{color.R:x2}{color.G:x2}{color.B:x2}";
        return hex == Value ? Task.CompletedTask : ValueChanged.InvokeAsync(hex);
    }
}
