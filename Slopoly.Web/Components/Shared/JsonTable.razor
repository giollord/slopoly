@* Renders a JSON array of objects (a build-report section) as a dense table; "ok" columns become pass/fail chips. *@
@if (Rows is { Count: > 0 })
{
    @if (Title is not null)
    {
        <MudText Typo="Typo.subtitle2" Class="mt-3">@Title</MudText>
    }
    <MudSimpleTable Dense="true">
        <thead><tr>@foreach (var c in Columns) { <th>@c</th> }</tr></thead>
        <tbody>
            @foreach (var row in Rows.OfType<JsonObject>())
            {
                <tr>
                    @foreach (var c in Columns)
                    {
                        <td>
                            @if (c == "ok" && row[c] is JsonValue ok)
                            {
                                <MudChip T="string" Size="Size.Small" Color="@(ok.GetValue<bool>() ? Color.Success : Color.Error)">@(ok.GetValue<bool>() ? "ok" : "fail")</MudChip>
                            }
                            else
                            {
                                @Text(row[c])
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </MudSimpleTable>
}

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public JsonArray? Rows { get; set; }
    [Parameter, EditorRequired] public string[] Columns { get; set; } = [];

    private static string Text(JsonNode? node) => node switch
    {
        null => "",
        JsonValue v when v.TryGetValue<string>(out var s) => s,
        JsonArray a when a.All(x => x is JsonValue) => string.Join(", ", a.Select(x => x?.ToString())),
        _ => node.ToJsonString(),
    };
}
