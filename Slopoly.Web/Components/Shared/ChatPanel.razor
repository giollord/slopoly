@inherits LiveComponent
@inject IJSRuntime JS

@* A chat with the agent: picks up the newest chat of its scope (an asset, a scene, a pack or everything), lets the user
   switch chats or start a new one, loads long chats in steps, and stops running turns. A new chat records Context;
   every message carries the page the user sends it from. *@
<div class="chat" style="height: @Height">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="chat-header">
        <MudSelect T="Guid?" Value="_chat?.Id" ValueChanged="OpenAsync" Placeholder="New chat" Dense="true" Variant="Variant.Outlined"
                   Margin="Margin.Dense" Class="flex-grow-1" AnchorOrigin="Origin.BottomLeft" aria-label="Chat">
            @foreach (var chat in _chats)
            {
                <MudSelectItem T="Guid?" Value="chat.Id">@chat.Title · @chat.UpdatedAt.ToLocalTime().ToString("g")</MudSelectItem>
            }
        </MudSelect>
        <MudTooltip Text="New chat (starts from what this page shows)">
            <MudIconButton Icon="@Icons.Material.Filled.AddComment" Size="Size.Small" OnClick="NewChat" aria-label="New chat" />
        </MudTooltip>
    </MudStack>
    <div class="chat-history" @ref="_history">
        @if (_chat is null)
        {
            <MudText Typo="Typo.caption" Class="d-block mb-2">A new chat. Your first message tells the agent what this page shows.</MudText>
        }
        @if (_total > _turns.Count)
        {
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="LoadEarlierAsync" Class="mb-2">Load earlier (@(_total - _turns.Count) more)</MudButton>
        }
        @foreach (var turn in _turns)
        {
            <MudPaper Class="pa-2 mb-2" Elevation="0" Style="background: var(--mud-palette-primary-hover)">
                <MudText Typo="Typo.body2" Class="pre-wrap">@(turn.Job.Inputs["message"]?.GetValue<string>())</MudText>
            </MudPaper>
            @foreach (var e in turn.Events.Where(e => e.Type is "stream" or "failed"))
            {
                var data = e.Data ?? [];
                @switch (e.Type == "failed" ? "failed" : data["kind"]?.GetValue<string>())
                {
                    case "text":
                        <MudText Typo="Typo.body2" Class="pre-wrap mb-2">@(data["text"]?.GetValue<string>())</MudText>
                        break;
                    case "tool_use":
                        <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Filled.Build" Variant="Variant.Outlined">@(data["name"]?.GetValue<string>())</MudChip>
                        break;
                    case "tool_result" when data["isError"]?.GetValue<bool>() == true:
                        <MudText Typo="Typo.caption" Color="Color.Error" Class="pre-wrap d-block">@(data["text"]?.GetValue<string>())</MudText>
                        break;
                    case "result":
                        <MudText Typo="Typo.caption" Class="d-block mb-3">@data["turns"] turns · $@(data["costUsd"]?.GetValue<double?>()?.ToString("0.00") ?? "?")</MudText>
                        break;
                    case "failed":
                        <MudAlert Severity="@(data["code"]?.GetValue<string>() == "auth" ? Severity.Warning : Severity.Error)" Dense="true" Class="mb-2">
                            @(data["code"]?.GetValue<string>() == "auth" ? "The agent is not authorised. " : "")@(data["error"]?.GetValue<string>())
                        </MudAlert>
                        break;
                }
            }
            @if (turn.Job.State == JobState.Cancelled)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block mb-3">Stopped.</MudText>
            }
            else if (turn.Job.State is JobState.Queued or JobState.Running)
            {
                <MudProgressLinear Indeterminate="@(turn.Job.State == JobState.Running)" Class="mb-2" />
                @if (turn.Job.State == JobState.Queued)
                {
                    <MudText Typo="Typo.caption" Class="d-block mb-2">Queued.</MudText>
                }
            }
        }
    </div>
    <div class="chat-composer">
        <MudTextField @bind-Value="_message" Label="Message the agent" Lines="3" Variant="Variant.Outlined" Immediate="true" />
        <MudStack Row="true" Spacing="1">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_message)" OnClick="SendAsync" Class="flex-grow-1">Send</MudButton>
            @if (Busy)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Stop" OnClick="StopAsync">Stop</MudButton>
            }
        </MudStack>
    </div>
</div>

@code {
    private const int PageSize = 20;

    /// <summary>The page the panel sits on: a new chat's context, and the page line of each message.</summary>
    [Parameter, EditorRequired] public ChatContext Context { get; set; } = null!;
    /// <summary>Which chats the panel lists and opens first: of this asset, scene or pack (none: all chats).</summary>
    [Parameter] public Guid? AssetId { get; set; }
    [Parameter] public Guid? SceneId { get; set; }
    [Parameter] public Guid? PackId { get; set; }
    /// <summary>A chat to open (e.g. the drawer asked to show one).</summary>
    [Parameter] public Guid? ChatId { get; set; }
    [Parameter] public string Height { get; set; } = "calc(100vh - 64px)";

    private List<Chat> _chats = [];
    private Chat? _chat;
    private List<ChatTurn> _turns = [];
    private int _total;
    private string _message = "";
    private ElementReference _history;
    private int _shown;
    private bool _picked; // the user chose a chat (or "new"): don't jump to the newest one on reload
    private Guid? _openedFor;

    private bool Busy => _turns.Any(t => t.Job.State is JobState.Queued or JobState.Running);

    private string Scope => $"api/chats?take=25{(AssetId is { } a ? $"&assetId={a}" : "")}{(SceneId is { } s ? $"&sceneId={s}" : "")}{(PackId is { } p ? $"&packId={p}" : "")}";

    // Keep the newest message in view when turns or stream events arrive.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var count = _turns.Sum(t => t.Events.Count + 1);
        if (count == _shown) return;
        var grewAtEnd = count > _shown;
        _shown = count;
        if (!grewAtEnd) return;
        try { await JS.InvokeVoidAsync("slopolyViewer.scrollToEnd", _history); } catch (JSException) { } catch (JSDisconnectedException) { }
    }

    protected override async Task LoadAsync()
    {
        if (ChatId is { } requested && requested != _openedFor) { _openedFor = requested; _picked = true; _chat = await Api.GetAsync<Chat>($"api/chats/{requested}"); }
        _chats = (await Api.GetAsync<Page<Chat>>(Scope)).Items;
        if (_chat is { } current && _chats.All(c => c.Id != current.Id)) _chats.Insert(0, current);
        if (!_picked) _chat = _chats.FirstOrDefault();
        await LoadTurnsAsync();
    }

    private async Task LoadTurnsAsync()
    {
        if (_chat is null) { _turns = []; _total = 0; return; }
        var page = await Api.GetAsync<Page<ChatTurn>>($"api/chats/{_chat.Id}/turns?take={Math.Max(PageSize, _turns.Count)}");
        (_turns, _total) = (page.Items, page.Total);
    }

    // Chats are found by scope; their turns are matched by chat id (a chat may belong to no pack).
    protected override bool Concerns(Guid? packId, Guid? assetId) => false;

    protected override bool ConcernsJob(JobEventMessage e) => e.Kind == JobKinds.AgentTurn && _chat is not null && e.ChatId == _chat.Id;

    protected override Task OnJobEventAsync(JobEventMessage e)
    {
        if (e.Type == "progress") return Task.CompletedTask;
        if (e.Type == "stream" && _turns.FirstOrDefault(t => t.Job.Id == e.JobId) is { } turn)
        {
            turn.Events.Add(new JobEvent { JobId = e.JobId, Type = e.Type, Data = e.Data });
            return Task.CompletedTask;
        }
        return LoadTurnsAsync();
    }

    private async Task OpenAsync(Guid? id)
    {
        _picked = true;
        _chat = _chats.FirstOrDefault(c => c.Id == id);
        _turns = [];
        await Try(LoadTurnsAsync);
    }

    private void NewChat()
    {
        _picked = true;
        _chat = null;
        _turns = [];
        _total = 0;
    }

    private async Task LoadEarlierAsync()
    {
        if (_chat is null || _turns.Count == 0) return;
        await Try(async () =>
        {
            var page = await Api.GetAsync<Page<ChatTurn>>($"api/chats/{_chat.Id}/turns?take={PageSize}&before={_turns[0].Job.Id}");
            _turns.InsertRange(0, page.Items);
            _total = page.Total;
            _shown = _turns.Sum(t => t.Events.Count + 1); // don't scroll to the end for older turns
        });
    }

    private Task SendAsync() => Try(async () =>
    {
        if (_chat is null)
        {
            _chat = await Api.PostAsync<Chat>("api/chats", new ChatCreate(Context));
            _picked = true;
        }
        await Api.PostAsync<Job>($"api/chats/{_chat.Id}/messages", new ChatMessage(_message.Trim(), Context));
        _message = "";
        await LoadAsync();
    });

    private Task StopAsync() => Try(async () =>
    {
        if (_chat is null) return;
        await Api.PostAsync<List<Job>>($"api/chats/{_chat.Id}/stop");
        await LoadTurnsAsync();
    });
}
