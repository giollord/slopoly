@inherits LiveComponent

<MudGrid>
    <MudItem xs="12" md="7">
        <MudStack>
            <MudTextField @bind-Value="_edit.Name" Label="Name" Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_edit.Instructions" Label="General instructions" Lines="3" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
                          HelperText="What the pack is for, constraints, target engine, ..." />
            <MudTextField @bind-Value="_edit.StyleText" Label="Style" Lines="4" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
                          HelperText="Look, shapes, palette mood and level of detail. Used in every image prompt." />
            <MudNumericField @bind-Value="_edit.PolyBudget" Label="Triangle budget per asset" Min="100" Step="100" Variant="Variant.Outlined" Style="max-width: 16rem" />

            <MudText Typo="Typo.subtitle1" Class="mt-2">Shading</MudText>
            <MudText Typo="Typo.body2">Applies to every asset of the pack from its next build.</MudText>
            <MudToggleGroup T="ShadingMode" @bind-Value="_edit.ShadingMode" Color="Color.Primary" Style="max-width: 16rem">
                <MudToggleItem Value="ShadingMode.Flat" Text="Flat" />
                <MudToggleItem Value="ShadingMode.Smooth" Text="Smooth" />
            </MudToggleGroup>
            @if (_edit.ShadingMode == ShadingMode.Smooth)
            {
                <MudNumericField @bind-Value="_edit.HardEdgeAngle" Label="Hard-edge angle (degrees)" Min="0" Max="180" Step="5" Variant="Variant.Outlined" Style="max-width: 16rem"
                                 HelperText="Edges sharper than this stay hard. 60 keeps 6–12-sided parts round and box corners hard." />
            }
            <MudSlider T="double" @bind-Value="_edit.ShadeStrength" Min="0" Max="1" Step="0.05" Color="Color.Primary" Style="max-width: 24rem">
                Vertex shade: @(_edit.ShadeStrength == 0 ? "off" : _edit.ShadeStrength.ToString("0.00"))
            </MudSlider>
            <MudText Typo="Typo.caption">Baked ambient occlusion and edge wear, stored as the standard glTF vertex colour.</MudText>
            <div><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">Save</MudButton></div>
        </MudStack>
    </MudItem>
    <MudItem xs="12" md="5">
        <MudText Typo="Typo.subtitle1">Style references</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">Images whose look the style anchor copies (up to 3 are used).</MudText>
        <MudGrid Spacing="1">
            @foreach (var reference in _references)
            {
                <MudItem xs="4">
                    <MudPaper Outlined="true" Class="pa-1">
                        <img class="concept-image" src="/files/@reference.FileId" alt="style reference" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="() => RemoveAsync(reference)" />
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
        <MudFileUpload T="IBrowserFile" FilesChanged="UploadAsync" Accept="image/*" Class="mt-2">
            <CustomContent>
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" OnClick="@context.OpenFilePickerAsync">Add reference</MudButton>
            </CustomContent>
        </MudFileUpload>

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle1">Style anchor</MudText>
        <MudTextField @bind-Value="_scene" Label="Scene description" Lines="3" Sizing="InputSizing.Auto" Variant="Variant.Outlined"
                      HelperText="Several typical objects of the pack in one scene." />
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
            <MudNumericField @bind-Value="_count" Label="Images" Min="1" Max="4" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 7rem" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_scene)" OnClick="GenerateAsync">Generate</MudButton>
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public Pack Pack { get; set; } = null!;
    private Edit _edit = new();
    private List<StyleReference> _references = [];
    private string _scene = "";
    private int _count = 2;

    private sealed class Edit
    {
        public string? Name { get; set; }
        public string? Instructions { get; set; }
        public string? StyleText { get; set; }
        public int PolyBudget { get; set; }
        public ShadingMode ShadingMode { get; set; }
        public double HardEdgeAngle { get; set; }
        public double ShadeStrength { get; set; }
    }

    protected override async Task LoadAsync()
    {
        _edit = new()
        {
            Name = Pack.Name, Instructions = Pack.Instructions, StyleText = Pack.StyleText, PolyBudget = Pack.PolyBudget,
            ShadingMode = Pack.ShadingMode, HardEdgeAngle = Pack.HardEdgeAngle, ShadeStrength = Pack.ShadeStrength,
        };
        _references = await Api.GetAsync<List<StyleReference>>($"api/packs/{Pack.Id}/style-references");
    }

    protected override bool Concerns(Guid? packId, Guid? assetId) => packId == Pack.Id && assetId is null;

    protected override Task OnJobEventAsync(JobEventMessage e) => Task.CompletedTask;

    private Task SaveAsync() => Try(async () =>
    {
        await Api.PatchAsync<Pack>($"api/packs/{Pack.Id}", new PackEdit(_edit.Name, _edit.Instructions, _edit.StyleText, _edit.PolyBudget,
            _edit.ShadingMode, _edit.HardEdgeAngle, _edit.ShadeStrength));
        Snackbar.Add("Saved", Severity.Success);
    });

    private Task UploadAsync(IBrowserFile file) => Try(async () =>
    {
        await using var stream = file.OpenReadStream(20 * 1024 * 1024);
        await Api.UploadAsync<StyleReference>($"api/packs/{Pack.Id}/style-references", stream, file.Name, file.ContentType);
    });

    private Task RemoveAsync(StyleReference reference) => Try(() => Api.DeleteAsync($"api/style-references/{reference.Id}"));

    private Task GenerateAsync() => Try(async () =>
    {
        await Api.PostAsync<Job>($"api/packs/{Pack.Id}/generate", new GenerateRequest(Workflows.StyleAnchor, null, _scene, _count));
        Snackbar.Add("Style anchor queued; images appear under Concepts.", Severity.Info);
    });
}
