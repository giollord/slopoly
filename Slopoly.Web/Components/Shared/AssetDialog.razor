@* Creates or edits an asset; returns an AssetEdit (PolyBudget 0 = use the pack's budget). *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: min(30rem, 80vw)">
            <MudTextField T="string" @bind-Value="_name" Label="Name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            <MudTextField T="string" @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Lines="3" Sizing="InputSizing.Auto" />
            <MudNumericField T="int?" @bind-Value="_budget" Label="Triangle budget" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true"
                             Placeholder="@($"pack default ({PackBudget})")" HelperText="Characters usually need more than props; leave empty for the pack default." />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="string.IsNullOrWhiteSpace(_name)"
                   OnClick="() => Dialog.Close(DialogResult.Ok(new AssetEdit(_name.Trim(), _description.Trim(), _budget ?? 0)))">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public Asset? Asset { get; set; }
    [Parameter] public int PackBudget { get; set; }
    private string _name = "", _description = "";
    private int? _budget;

    protected override void OnInitialized() => (_name, _description, _budget) = (Asset?.Name ?? "", Asset?.Description ?? "", Asset?.PolyBudget);

    /// <summary>Opens the dialog; null when cancelled.</summary>
    public static async Task<AssetEdit?> ShowAsync(IDialogService dialogs, Asset? asset, int packBudget)
    {
        var dialog = await dialogs.ShowAsync<AssetDialog>(asset is null ? "New asset" : $"Edit {asset.Name}",
            new DialogParameters<AssetDialog> { { d => d.Asset, asset }, { d => d.PackBudget, packBudget } });
        return await dialog.Result is { Canceled: false, Data: AssetEdit edit } ? edit : null;
    }
}
