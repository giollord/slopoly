@* Generates style anchors (scenes) or heroes of one asset. *@
<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width: min(32rem, 80vw)">
            <MudRadioGroup T="string" @bind-Value="_operation">
                <MudRadio T="string" Value="Workflows.StyleAnchor" Color="Color.Primary">Style anchor (scene)</MudRadio>
                <MudRadio T="string" Value="Workflows.Hero" Color="Color.Primary">Hero (one asset)</MudRadio>
            </MudRadioGroup>
            @if (_operation == Workflows.Hero)
            {
                <MudSelect T="Guid?" @bind-Value="_assetId" Label="Asset" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (var a in PackAssets)
                    {
                        <MudSelectItem T="Guid?" Value="a.Id">@a.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudTextField T="string" @bind-Value="_description" Variant="Variant.Outlined" Lines="4" Sizing="InputSizing.Auto"
                          Label="@(_operation == Workflows.StyleAnchor ? "Scene description" : "Object description (optional)")"
                          Placeholder="@(_operation == Workflows.StyleAnchor ? "a market square with a cart, a well and two stalls" : "defaults to the asset's name and description")" />
            <MudNumericField T="int" @bind-Value="_count" Label="Images" Min="1" Max="4" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 8rem" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => Dialog.Cancel()">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="!Valid" OnClick="Submit">Generate</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = null!;
    [Parameter] public List<Asset> PackAssets { get; set; } = [];
    [Parameter] public Guid? AssetId { get; set; }
    private string _operation = Workflows.StyleAnchor, _description = "";
    private Guid? _assetId;
    private int _count = 2;

    protected override void OnInitialized()
    {
        _assetId = AssetId;
        if (AssetId is not null) _operation = Workflows.Hero;
    }

    private bool Valid => _operation == Workflows.StyleAnchor ? !string.IsNullOrWhiteSpace(_description) : _assetId is not null;

    private void Submit() => Dialog.Close(DialogResult.Ok(new GenerateRequest(_operation, _operation == Workflows.Hero ? _assetId : null,
        string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(), _count)));
}
