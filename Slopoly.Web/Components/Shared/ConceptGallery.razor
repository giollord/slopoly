@inherits LiveComponent
@inject IDialogService Dialogs

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-3">
    <MudToggleGroup T="string" @bind-Value="_kind" Size="Size.Small" Color="Color.Primary" Outlined="true" Style="width: 26rem; flex: none">
        <MudToggleItem Value="@("all")" Text="All" />
        <MudToggleItem Value="@(nameof(ConceptKind.Anchor))" Text="Style anchors" />
        <MudToggleItem Value="@(nameof(ConceptKind.Turnaround))" Text="Turnarounds" />
    </MudToggleGroup>
    <div class="filter-field"><MudSelect T="Guid?" @bind-Value="_assetFilter" Label="Asset" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (var a in _assets)
        {
            <MudSelectItem T="Guid?" Value="a.Id">@a.Name</MudSelectItem>
        }
    </MudSelect></div>
    <div class="filter-field"><MudSelect T="string" Value="_selection" ValueChanged="SelectionFilterAsync" Label="Selection" Variant="Variant.Outlined" Margin="Margin.Dense">
        <MudSelectItem Value="@("visible")">Not rejected</MudSelectItem>
        <MudSelectItem Value="@(nameof(Selection.Picked))">Picked</MudSelectItem>
        <MudSelectItem Value="@(nameof(Selection.None))">Undecided</MudSelectItem>
        <MudSelectItem Value="@(nameof(Selection.Rejected))">Rejected</MudSelectItem>
        <MudSelectItem Value="@("all")">All</MudSelectItem>
    </MudSelect></div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="NewAsync">New</MudButton>
</MudStack>

@{ var shown = Filtered().ToList(); }
@if (shown.Count == 0)
{
    <MudAlert Severity="Severity.Info">No concept images match.</MudAlert>
}
@foreach (var group in shown.GroupBy(c => c.Kind).OrderBy(g => g.Key))
{
    <MudText Typo="Typo.subtitle1" Class="mt-2 mb-1">@(group.Key == ConceptKind.Anchor ? "Style anchors (scenes)" : "Turnarounds (single objects)") · @group.Count()</MudText>
    <MudGrid Spacing="2" Class="mb-4">
        @foreach (var concept in group)
        {
            var turnaround = concept.Kind == ConceptKind.Turnaround;
            <MudItem xs="12" sm="@(turnaround ? 12 : 6)" md="@(turnaround ? 6 : 4)" lg="@(turnaround ? 6 : 3)">
                <MudCard Outlined="true" Style="@(concept.Selection == Selection.Picked ? "border: 2px solid var(--mud-palette-success)" : "")">
                    <a href="/concepts/@concept.Id" title="Open">
                        <img class="concept-image" src="/files/@concept.FileId" alt="@concept.Kind" loading="lazy"
                             style="@(concept.Selection == Selection.Rejected ? "opacity: .35" : "")" />
                    </a>
                    <MudCardActions Class="py-0">
                        @if (concept.AssetId is { } assetId && _assets.FirstOrDefault(a => a.Id == assetId) is { } asset)
                        {
                            <MudChip T="string" Size="Size.Small" Href="@($"/assets/{assetId}")">@asset.Name</MudChip>
                        }
                        <MudSpacer />
                        <ConceptActions Concept="concept" OnDeleted="LoadAsync" />
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    [Parameter, EditorRequired] public Guid PackId { get; set; }
    private List<ConceptImage> _concepts = [];
    private List<Asset> _assets = [];
    private string _kind = "all", _selection = "visible";
    private Guid? _assetFilter;

    protected override async Task LoadAsync()
    {
        _concepts = (await Api.GetAsync<List<ConceptImage>>($"api/packs/{PackId}/concepts?includeRejected={_selection is not "visible"}"))
            .OrderByDescending(c => c.CreatedAt).ToList();
        _assets = await Api.GetAsync<List<Asset>>($"api/packs/{PackId}/assets");
    }

    private IEnumerable<ConceptImage> Filtered() => _concepts.Where(c =>
        (_kind == "all" || c.Kind.ToString() == _kind)
        && (_assetFilter is null || c.AssetId == _assetFilter)
        && (_selection is "visible" or "all" || c.Selection.ToString() == _selection));

    protected override bool Concerns(Guid? packId, Guid? assetId) => packId == PackId;

    private Task SelectionFilterAsync(string value)
    {
        _selection = value;
        return Try(LoadAsync);
    }

    private async Task NewAsync()
    {
        var dialog = await Dialogs.ShowAsync<NewConceptDialog>("New concept images",
            new DialogParameters<NewConceptDialog> { { d => d.PackAssets, _assets }, { d => d.AssetId, _assetFilter } });
        if (await dialog.Result is { Canceled: false, Data: GenerateRequest request })
            await Try(async () =>
            {
                await Api.PostAsync<Job>($"api/packs/{PackId}/generate", request);
                Snackbar.Add($"{request.Count} image(s) queued; they appear here when ready.", Severity.Info);
            });
    }
}
