@page "/assets/{AssetId:guid}"
@inherits LiveComponent
@inject IJSRuntime JS
@inject IDialogService Dialogs
@inject NavigationManager Nav

<PageTitle>@(_asset?.Name ?? "Asset") · Slopoly</PageTitle>

@if (_asset is null)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<PackCrumbs PackId="_asset.PackId" PackName="@_pack?.Name" Tab="assets" Current="@_asset.Name" />
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">@_asset.Name</MudText>
    <MudChip T="string" Size="Size.Small" Color="@AssetList.StatusColor(_asset.Status)">@_asset.Status</MudChip>
    <MudText Typo="Typo.body2">@_asset.Description · @(_asset.PolyBudget is { } b ? $"{b} triangles" : $"pack budget ({_pack?.PolyBudget} triangles)")</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Edit" OnClick="EditAsync">Edit</MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">Delete</MudButton>
</MudStack>

<MudGrid>
    <MudItem xs="12" lg="6">
        @if (_build?.GlbFileId is { } glb)
        {
            <model-viewer @ref="_viewer" src="/files/@glb" camera-controls auto-rotate shadow-intensity="0.6" exposure="1"
                          style="width: 100%; height: 480px; background: var(--mud-palette-background-gray)"></model-viewer>
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                <MudSelect T="Guid?" Value="_variantId" ValueChanged="SetVariantAsync" Label="Palette" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Clearable="true" Placeholder="main" Style="max-width: 14rem">
                    @foreach (var v in _variants.Where(v => v.TextureFileId is not null))
                    {
                        <MudSelectItem T="Guid?" Value="v.Id">@v.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudSpacer />
                <MudButton Href="@($"/builds/{_build.Id}/export")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download">Export</MudButton>
            </MudStack>
        }
        else
        {
            <MudAlert Severity="Severity.Info">No build with a model yet.</MudAlert>
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4">
            <MudText Typo="Typo.subtitle1">Manifest</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="_manifestText == _manifestSaved" OnClick="SaveManifestAsync">Save manifest</MudButton>
        </MudStack>
        <MudTextField T="string" @bind-Value="_manifestText" Variant="Variant.Outlined" Lines="14" Class="code-input" Immediate="true"
                      Placeholder='{ "parts": [ { "name": "bed" }, { "name": "wheel", "parent": "bed", "mirror": "x" } ] }' />
    </MudItem>

    <MudItem xs="12" lg="6">
        <MudText Typo="Typo.subtitle1">Builds</MudText>
        <MudSimpleTable Dense="true" Hover="true">
            <thead><tr><th>Created</th><th>Program</th><th>Validated</th><th>Mean IoU</th></tr></thead>
            <tbody>
                @foreach (var b in _builds)
                {
                    <tr @onclick="() => SelectBuild(b)" style="cursor: pointer; @(b == _build ? "font-weight: bold" : "")">
                        <td>@b.CreatedAt.ToLocalTime().ToString("g")</td>
                        <td>v@(_programs.FirstOrDefault(p => p.Id == b.ProgramVersionId)?.Number)</td>
                        <td><MudChip T="string" Size="Size.Small" Color="@(b.Validated ? Color.Success : Color.Warning)">@(b.Validated ? "yes" : "no")</MudChip></td>
                        <td>@b.Report?["silhouette"]?["mean_iou"]</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>

        @if (_build?.Report is { } report)
        {
            @if (report["error"] is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-2">Line @report["line"]: @report["error"]</MudAlert>
            }
            var validation = report["validation"];
            <JsonTable Title="Parts" Rows="@(report["parts"] as JsonArray)" Columns="@(["name", "parent", "mesh", "triangles", "joint", "line"])" />
            <JsonTable Title="Issues" Rows="@(validation?["issues"] as JsonArray)" Columns="@(["issue", "part", "parts", "message"])" />
            <JsonTable Title="Intersections" Rows="@(validation?["intersections"] as JsonArray)" Columns="@(["a", "b", "fraction", "allowed", "ok"])" />
            <JsonTable Title="Contacts" Rows="@(validation?["contacts"] as JsonArray)" Columns="@(["part", "parent", "gap", "ok"])" />
            @if (validation?["triangles"] is JsonObject tri)
            {
                <MudText Typo="Typo.body2" Class="mt-2">Triangles: @tri["count"] / @tri["budget"]@(validation["disconnected"] is JsonArray { Count: > 0 } d ? $" · disconnected: {Text(d)}" : "")</MudText>
            }
            @foreach (var view in (report["silhouette"]?["views"] as JsonArray ?? []).OfType<JsonObject>())
            {
                <JsonTable Title="@($"Silhouette · {view["view"]}{(view["skipped"] is { } s ? $" (skipped: {s})" : "")}")"
                           Rows="@(view["parts"] as JsonArray)" Columns="@(["mask", "parts", "iou", "width_error", "height_error", "centre_offset"])" />
            }
            <JsonTable Title="Colours" Rows="@(report["colors"] as JsonArray)" Columns="@(["mask", "view", "role", "role_color", "mask_color", "delta_e", "ok"])" />
        }

        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4">
            <MudText Typo="Typo.subtitle1">New program version</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="LoadCurrentSource">Start from current</MudButton>
        </MudStack>
        <MudTextField T="string" @bind-Value="_source" Variant="Variant.Outlined" Lines="16" Class="code-input" Placeholder="part(&quot;bed&quot;, box(0.8, 0.3, 0.7), color=&quot;wood&quot;)" />
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
            <MudTextField T="string" @bind-Value="_note" Label="Note" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_source)" OnClick="SubmitProgramAsync">Submit and build</MudButton>
        </MudStack>

        <MudText Typo="Typo.subtitle1" Class="mt-4">Program versions</MudText>
        <MudExpansionPanels Dense="true">
            @foreach (var p in _programs)
            {
                <MudExpansionPanel Text="@($"v{p.Number} · {p.CreatedAt.ToLocalTime():g} · {p.Note}{(p.Id == _asset.CurrentProgramVersionId ? " (current)" : "")}")">
                    @if (p.Id != _asset.CurrentProgramVersionId)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => SetCurrentAsync(p)" Class="mb-2">Set current</MudButton>
                    }
                    <pre class="code">@p.Source</pre>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    </MudItem>
</MudGrid>

@code {
    private static readonly System.Text.Json.JsonSerializerOptions Indented = new() { WriteIndented = true };
    [Parameter] public Guid AssetId { get; set; }
    private Asset? _asset;
    private Pack? _pack;
    private bool _deleted;
    private string _manifestText = "", _manifestSaved = "", _source = "", _note = "";
    private Manifest? _manifest;
    private List<ProgramVersion> _programs = [];
    private List<Build> _builds = [];
    private List<VariantView> _variants = [];
    private Build? _build;
    private Guid? _variantId;
    private ElementReference _viewer;

    protected override async Task LoadAsync()
    {
        _asset = await Api.GetAsync<Asset>($"api/assets/{AssetId}");
        _pack = await Api.GetAsync<Pack>($"api/packs/{_asset.PackId}");
        _manifest = await Api.FindAsync<Manifest>($"api/assets/{AssetId}/manifest");
        var saved = _manifest?.Content.ToJsonString(Indented) ?? "";
        if (_manifestText == _manifestSaved) _manifestText = saved; // keep unsaved edits
        _manifestSaved = saved;
        _programs = await Api.GetAsync<List<ProgramVersion>>($"api/assets/{AssetId}/programs");
        _builds = await Api.GetAsync<List<Build>>($"api/assets/{AssetId}/builds");
        _variants = (await Api.GetAsync<PaletteView>($"api/packs/{_asset.PackId}/palette")).Variants;
        _build = _builds.FirstOrDefault(b => b.Id == _build?.Id) ?? _builds.FirstOrDefault();
    }

    // Palette edits of the pack (asset-less changes) re-render textures, so they concern this page too.
    protected override bool Concerns(Guid? packId, Guid? assetId) => !_deleted && (assetId == AssetId || (assetId is null && packId == _asset?.PackId));

    private void SelectBuild(Build b) { _build = b; _variantId = null; }

    private async Task SetVariantAsync(Guid? id)
    {
        _variantId = id;
        var texture = _variants.FirstOrDefault(v => v.Id == id)?.TextureFileId
                      ?? (await Api.GetAsync<PaletteView>($"api/packs/{_asset!.PackId}/palette")).TextureFileId;
        if (texture is null) return;
        try { await JS.InvokeVoidAsync("slopolyViewer.setPalette", _viewer, $"/files/{texture}"); }
        catch (JSException ex) { Snackbar.Add($"The viewer could not swap the palette: {ex.Message}", Severity.Error); }
    }

    private Task SetCurrentAsync(ProgramVersion p) =>
        Try(() => Api.PutAsync<Asset>($"api/assets/{AssetId}/current-version", new CurrentVersionEdit(p.Id)));

    private async Task EditAsync()
    {
        if (await AssetDialog.ShowAsync(Dialogs, _asset, _pack?.PolyBudget ?? 0) is { } edit)
            await Try(() => Api.PatchAsync<Asset>($"api/assets/{AssetId}", edit));
    }

    private async Task DeleteAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete asset", $"Delete \"{_asset!.Name}\" with its concept images, manifest, programs and builds? This can't be undone.",
                yesText: "Delete", cancelText: "Cancel") != true) return;
        await Try(async () =>
        {
            _deleted = true;
            await Api.DeleteAsync($"api/assets/{AssetId}");
            Nav.NavigateTo($"/packs/{_asset.PackId}?tab=assets");
        });
    }

    private Task SaveManifestAsync() => Try(async () =>
    {
        JsonObject content;
        try { content = JsonNode.Parse(_manifestText) as JsonObject ?? throw new System.Text.Json.JsonException("not an object"); }
        catch (System.Text.Json.JsonException ex) { Snackbar.Add($"The manifest is not a JSON object: {ex.Message}", Severity.Error); return; }
        var saved = await Api.PutAsync<Manifest>($"api/assets/{AssetId}/manifest", content);
        _manifestText = _manifestSaved = saved.Content.ToJsonString(Indented);
        Snackbar.Add("Manifest saved.", Severity.Success);
    });

    private void LoadCurrentSource() => _source = _programs.FirstOrDefault(p => p.Id == _asset?.CurrentProgramVersionId)?.Source ?? "";

    private Task SubmitProgramAsync() => Try(async () =>
    {
        await Api.PostAsync<System.Text.Json.Nodes.JsonObject>($"api/assets/{AssetId}/programs", new ProgramSubmit(_source, string.IsNullOrWhiteSpace(_note) ? "edited by hand" : _note.Trim()));
        _note = "";
        Snackbar.Add("New version submitted; the build appears in the table when done.", Severity.Info);
    });

    private static string Text(JsonArray a) => string.Join(", ", a.Select(x => x?.ToString()));
}
