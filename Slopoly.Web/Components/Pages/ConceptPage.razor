@page "/concepts/{ConceptId:guid}"
@inherits LiveComponent
@inject PageContext PageCtx
@inject NavigationManager Nav

<PageTitle>Concept · Slopoly</PageTitle>

@if (_concept is null || _pack is null)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<PackCrumbs PackId="_pack.Id" PackName="@_pack.Name" Tab="concepts" Current="@($"{Kind} {_concept.CreatedAt.ToLocalTime():g}")" />

<MudGrid>
    <MudItem xs="12" lg="8">
        @if (_siblings.Count > 1)
        {
            var at = _siblings.FindIndex(c => c.Id == _concept.Id);
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.Center" Spacing="1" Class="mb-1">
                <MudTooltip Text="Previous image"><MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Disabled="at <= 0" Href="@(at > 0 ? $"/concepts/{_siblings[at - 1].Id}" : null)" /></MudTooltip>
                <MudText Typo="Typo.body2">@(at + 1) of @_siblings.Count @SiblingsName</MudText>
                <MudTooltip Text="Next image"><MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Disabled="at >= _siblings.Count - 1" Href="@(at < _siblings.Count - 1 ? $"/concepts/{_siblings[at + 1].Id}" : null)" /></MudTooltip>
            </MudStack>
        }
        <a href="/files/@_concept.FileId" target="_blank" title="Open the image file">
            <img src="/files/@_concept.FileId" alt="@Kind" style="width: 100%; height: auto; border-radius: 4px; background: var(--mud-palette-background-gray)" />
        </a>
    </MudItem>
    <MudItem xs="12" lg="4">
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (_concept.Kind != ConceptKind.View)
                {
                    <MudChip T="string" Size="Size.Small" Color="@(_concept.Selection switch { Selection.Picked => Color.Success, Selection.Rejected => Color.Error, _ => Color.Default })">
                        @(_concept.Selection == Selection.None ? "Undecided" : _concept.Selection)
                    </MudChip>
                }
                <MudSpacer />
                <ConceptActions Concept="_concept" OnDeleted="@(() => Nav.NavigateTo($"/packs/{_pack.Id}?tab=concepts"))" />
            </MudStack>

            <MudSimpleTable Dense="true">
                <tbody>
                    <tr><td>Kind</td><td>@Kind</td></tr>
                    @if (_hero is not null)
                    {
                        <tr><td>Hero</td><td><MudLink Href="@($"/concepts/{_hero.Id}")">open the hero</MudLink></td></tr>
                    }
                    @if (_concept.MaskFileId is { } mask)
                    {
                        <tr><td>Silhouette</td><td><MudLink Href="@($"/files/{mask}")" Target="_blank">mask image</MudLink></td></tr>
                    }
                    @if (_asset is not null)
                    {
                        <tr><td>Asset</td><td><MudLink Href="@($"/assets/{_asset.Id}")">@_asset.Name</MudLink></td></tr>
                    }
                    @if (_concept.Kind != ConceptKind.View)
                    {
                        <tr><td>Seed</td><td>@(_concept.Seed?.ToString() ?? "not recorded")</td></tr>
                    }
                    <tr><td>Size</td><td>@_concept.Width × @_concept.Height</td></tr>
                    <tr><td>Created</td><td>@_concept.CreatedAt.ToLocalTime().ToString("g")</td></tr>
                    @if (_job is not null)
                    {
                        <tr><td>Job</td><td>@_job.Operation@(_job.Inputs["count"] is { } count ? $" · {count} image(s)" : "") · @_job.State</td></tr>
                    }
                </tbody>
            </MudSimpleTable>

            @if (_job?.Inputs["prompt"]?.GetValue<string>() is { } prompt)
            {
                <div>
                    <MudText Typo="Typo.subtitle2">Prompt</MudText>
                    <MudText Typo="Typo.body2" Style="white-space: pre-wrap">@prompt</MudText>
                </div>
            }
            @if (_job?.Inputs["references"] is JsonArray { Count: > 0 } references)
            {
                <div>
                    <MudText Typo="Typo.subtitle2">Reference images</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        @foreach (var r in references)
                        {
                            <a href="/files/@r" target="_blank"><img src="/files/@r" alt="reference" style="height: 72px; border-radius: 4px" /></a>
                        }
                    </MudStack>
                </div>
            }

            @if (_concept.Kind == ConceptKind.Hero && _views.Count > 0)
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Views</MudText>
                    <MudGrid Spacing="1">
                        @foreach (var v in _views)
                        {
                            <MudItem xs="6">
                                <a href="/concepts/@v.Id" title="Open"><img src="/files/@v.FileId" alt="@v.View" style="width: 100%; border-radius: 4px; background: var(--mud-palette-background-gray)" /></a>
                                <MudText Typo="Typo.caption">@v.View</MudText>
                            </MudItem>
                        }
                    </MudGrid>
                    @if (_concept.Front == "assumed")
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">The front was assumed (the object isn't mirror-symmetric). Check that the front view shows its front.</MudAlert>
                    }
                    <MudText Typo="Typo.body2" Class="mt-2">Front at @(_concept.FrontYaw ?? 0)° (@_concept.Front). Turn it if the front view shows another side:</MudText>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-1">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => TurnAsync(-90)">Turn left 90°</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => TurnAsync(90)">Turn right 90°</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="() => TurnAsync(180)">Flip 180°</MudButton>
                    </MudStack>
                </MudPaper>
            }

            @if (_concept.Kind != ConceptKind.View)
            {
            <MudPaper Outlined="true" Class="pa-3">
                <MudText Typo="Typo.subtitle2" Class="mb-2">Change with the agent</MudText>
                <MudTextField T="string" @bind-Value="_change" Variant="Variant.Outlined" Lines="3" Sizing="InputSizing.Auto"
                              Placeholder="What should change? e.g. taller wheels, darker wood, no cargo. Leave empty for more options like this one." />
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-2">
                    <MudNumericField T="int" @bind-Value="_count" Label="Images" Min="1" Max="4" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 7rem" />
                    <MudSpacer />
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Send" OnClick="AskAgentAsync">Ask the agent</MudButton>
                </MudStack>
            </MudPaper>
            }

            @if (_concept.Kind == ConceptKind.Hero && _concept.Selection == Selection.Picked && _views.Count > 0)
            {
                <MudPaper Outlined="true" Class="pa-3">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Segment parts</MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudTextField T="string" @bind-Value="_parts" Label="Parts (comma separated)" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="bed, wheel, handle, axle" />
                        <MudButton Variant="Variant.Outlined" OnClick="SegmentAsync">Segment</MudButton>
                    </MudStack>
                    @if (_masks.Count > 0)
                    {
                        <MudSimpleTable Dense="true" Class="mt-2">
                            <thead><tr><th>Part</th><th>Found in views</th></tr></thead>
                            <tbody>
                                @foreach (var part in _masks.GroupBy(m => m.Part))
                                {
                                    <tr>
                                        <td>@part.Key</td>
                                        <td>
                                            @foreach (var m in part)
                                            {
                                                <MudLink Href="@($"/files/{m.FileId}")" Target="_blank" Class="mr-2">@m.View</MudLink>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                </MudPaper>
            }
        </MudStack>
    </MudItem>
</MudGrid>

@code {
    [Parameter] public Guid ConceptId { get; set; }
    private ConceptImage? _concept;
    private Pack? _pack;
    private Asset? _asset;
    private Job? _job;
    private ConceptImage? _hero;
    private List<ConceptImage> _views = [];
    private List<PartMask> _masks = [];
    /// <summary>The concepts the previous/next buttons step through: the same kind (a view's: its hero's views), newest first as in the gallery.</summary>
    private List<ConceptImage> _siblings = [];
    private string _change = "", _parts = "";
    private int _count = 2;

    private string Kind => _concept?.Kind switch
    {
        ConceptKind.Anchor => "Style anchor",
        ConceptKind.Hero => "Hero",
        _ => $"{_concept?.View} view",
    };

    protected override async Task LoadAsync()
    {
        _concept = await Api.GetAsync<ConceptImage>($"api/concepts/{ConceptId}");
        PageCtx.Set(new ChatContext(ChatPages.Concept, _concept.PackId, _concept.AssetId, _concept.VariantId, ConceptId: ConceptId));
        _pack = await Api.GetAsync<Pack>($"api/packs/{_concept.PackId}");
        _asset = _concept.AssetId is { } assetId ? await Api.GetAsync<Asset>($"api/assets/{assetId}") : null;
        _job = _concept.JobId is { } jobId ? await Api.GetAsync<Job>($"api/jobs/{jobId}") : null;
        _hero = _concept.SourceConceptId is { } heroId ? await Api.GetAsync<ConceptImage>($"api/concepts/{heroId}") : null;
        _views = _concept.Kind == ConceptKind.Hero ? await Api.GetAsync<List<ConceptImage>>($"api/concepts/{ConceptId}/views") : [];
        _masks = _concept.Kind == ConceptKind.Hero ? await Api.GetAsync<List<PartMask>>($"api/concepts/{ConceptId}/masks") : [];
        _siblings = _concept.Kind == ConceptKind.View && _concept.SourceConceptId is { } source
            ? await Api.GetAsync<List<ConceptImage>>($"api/concepts/{source}/views")
            : (await Api.GetAsync<List<ConceptImage>>($"api/packs/{_concept.PackId}/concepts?includeRejected={_concept.Selection == Selection.Rejected}"))
                .Where(c => c.Kind == _concept.Kind).OrderByDescending(c => c.CreatedAt).ToList();
    }

    private string SiblingsName => _concept?.Kind switch
    {
        ConceptKind.Anchor => "style anchors",
        ConceptKind.Hero => "heroes",
        _ => "views",
    };

    /// <summary>Remakes the views from the same splat with the front turned by the given degrees.</summary>
    private Task TurnAsync(double degrees) => Try(async () =>
    {
        await Api.PostAsync<Job>($"api/concepts/{ConceptId}/views", new ViewsRequest((_concept!.FrontYaw ?? 0) + degrees));
        Snackbar.Add("Remaking the views (about a minute).", Severity.Info);
    });

    protected override bool Concerns(Guid? packId, Guid? assetId) => packId == _concept?.PackId;

    protected override Task OnJobEventAsync(JobEventMessage e) => Task.CompletedTask; // new images show in the gallery

    /// <summary>The agent words the change and calls revise_concept, in a new chat about this concept; the user can
    /// follow it in the chat drawer.</summary>
    private Task AskAgentAsync() => Try(async () =>
    {
        var request = string.IsNullOrWhiteSpace(_change)
            ? $"Revise concept {ConceptId}: more options like it, no change. Make {_count} images."
            : $"Revise concept {ConceptId}: {_change.Trim()}. Make {_count} images.";
        var chat = await Api.PostAsync<Chat>("api/chats", new ChatCreate(PageCtx.Current));
        await Api.PostAsync<Job>($"api/chats/{chat.Id}/messages", new ChatMessage(request, PageCtx.Current));
        _change = "";
        Snackbar.Add("Sent to the agent; the new images will appear in Concepts.", Severity.Info, o =>
        {
            o.Action = "Open chat";
            o.OnClick = _ => { PageCtx.OpenChat(chat.Id); return Task.CompletedTask; };
        });
    });

    private Task SegmentAsync() => Try(async () =>
    {
        var parts = _parts.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();
        if (parts.Count == 0) { Snackbar.Add("Name the parts first.", Severity.Warning); return; }
        await Api.PostAsync<Job>($"api/concepts/{ConceptId}/segment", new SegmentRequest(parts));
        Snackbar.Add("Segmentation queued; the found parts appear here.", Severity.Info);
    });
}
