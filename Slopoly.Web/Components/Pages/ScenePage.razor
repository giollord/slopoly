@page "/scenes/{SceneId:guid}"
@inherits LiveComponent
@inject IDialogService Dialogs
@inject NavigationManager Nav
@inject PageContext PageCtx

<PageTitle>@(_scene?.Name ?? "Scene") · Slopoly</PageTitle>

@if (_scene is null || _pack is null)
{
    <MudProgressLinear Indeterminate="true" />
    return;
}

<PackCrumbs PackId="_pack.Id" PackName="@_pack.Name" Tab="scenes" Current="@_scene.Name" />
<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
    <MudText Typo="Typo.h5">@_scene.Name</MudText>
    @if (_building)
    {
        <MudChip T="string" Size="Size.Small" Color="Color.Info">building…</MudChip>
    }
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@(Dirty ? Icons.Material.Filled.Save : Icons.Material.Filled.Refresh)" OnClick="SaveAsync">
        @(Dirty ? "Save and build" : "Refresh")
    </MudButton>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAsync">Delete</MudButton>
</MudStack>

<MudGrid>
    <MudItem xs="12" lg="7">
        @if (_scene.GlbFileId is { } glb)
        {
            <ModelViewer Src="@($"/files/{glb}")" Height="480px" />
        }
        else
        {
            <MudAlert Severity="Severity.Info">Not built yet. Add placements and save.</MudAlert>
        }
    </MudItem>
    <MudItem xs="12" lg="5">
        <div class="chat-embedded">
            <ChatPanel Context="@(new ChatContext(ChatPages.Scene, _pack.Id, SceneId: SceneId))" SceneId="SceneId" Height="530px" />
        </div>
    </MudItem>
</MudGrid>

<MudExpansionPanels MultiExpansion="true" Class="mt-4">
    <MudExpansionPanel Text="Placements" Expanded="true">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.caption">metres, Y up, ground at y = 0; rotation in degrees</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="Add" Disabled="_assets.Count == 0">Add</MudButton>
        </MudStack>
        <MudTextField T="string" @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Lines="2" Sizing="InputSizing.Auto" Class="mt-1" Immediate="true" />
        <MudSimpleTable Dense="true" Class="scene-table mt-2">
            <thead><tr><th>Name</th><th>Asset</th><th>Variant</th><th>x</th><th>y</th><th>z</th><th>rot y</th><th>scale</th><th></th></tr></thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td><MudTextField T="string" @bind-Value="row.Name" Margin="Margin.Dense" Variant="Variant.Text" /></td>
                        <td>
                            <MudSelect T="Guid" Value="row.AssetId" ValueChanged="id => { row.AssetId = id; row.VariantId = null; }" Margin="Margin.Dense" Variant="Variant.Text">
                                @foreach (var a in _assets)
                                {
                                    <MudSelectItem T="Guid" Value="a.Id">@a.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </td>
                        <td>
                            <MudSelect T="Guid?" @bind-Value="row.VariantId" Margin="Margin.Dense" Variant="Variant.Text" Clearable="true" Placeholder="default">
                                @foreach (var v in _variants.Where(v => v.AssetId == row.AssetId))
                                {
                                    <MudSelectItem T="Guid?" Value="v.Id">@v.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </td>
                        @for (var i = 0; i < 3; i++)
                        {
                            var axis = i;
                            <td><MudNumericField T="double" Value="row.At[axis]" ValueChanged="v => { row.At[axis] = v; }" Step="0.1" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" /></td>
                        }
                        <td><MudNumericField T="double" Value="row.Rot[1]" ValueChanged="v => { row.Rot[1] = v; }" Step="15" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" /></td>
                        <td><MudNumericField T="double" Value="row.Scale" ValueChanged="v => { row.Scale = v; }" Step="0.1" Min="0.01" Margin="Margin.Dense" Variant="Variant.Text" HideSpinButtons="true" /></td>
                        <td><MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="() => { _rows.Remove(row); }" /></td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudExpansionPanel>

    <MudExpansionPanel Text="Versions" Expanded="true">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudText Typo="Typo.caption">One program version per asset variant, for all its placements.</MudText>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => _versions.Clear()" Disabled="_versions.Count == 0">Use current everywhere</MudButton>
        </MudStack>
        <MudSimpleTable Dense="true" Class="scene-table mt-2">
            <thead><tr><th>Asset</th><th>Variant</th><th>Placements</th><th>Version</th></tr></thead>
            <tbody>
                @foreach (var (assetId, variantId) in UsedVariants())
                {
                    var key = (assetId, variantId);
                    <tr>
                        <td>@_assets.FirstOrDefault(a => a.Id == assetId)?.Name</td>
                        <td>@_variants.FirstOrDefault(v => v.Id == variantId)?.Name</td>
                        <td>@_rows.Count(r => r.AssetId == assetId && VariantOf(r) == variantId)</td>
                        <td>
                            <MudSelect T="Guid?" Value="_versions.GetValueOrDefault(key)" ValueChanged="id => SetVersion(key, id)" Margin="Margin.Dense" Variant="Variant.Text"
                                       Clearable="true" Placeholder="@CurrentLabel(variantId)">
                                @foreach (var p in _programs.Where(p => p.VariantId == variantId))
                                {
                                    <MudSelectItem T="Guid?" Value="p.Id">v@(p.Number)@(string.IsNullOrWhiteSpace(p.Note) ? "" : $" · {p.Note}")</MudSelectItem>
                                }
                            </MudSelect>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    </MudExpansionPanel>

    @if (_scene.Report is { } report)
    {
        <MudExpansionPanel Text="Report">
            <JsonTable Title="Overlaps (bounding boxes)" Rows="@(report["overlaps"] as JsonArray)" Columns="@(["a", "b", "fraction"])" />
            <JsonTable Title="Placement bounds" Rows="@(report["placements"] as JsonArray)" Columns="@(["name", "grounded", "bounds"])" />
        </MudExpansionPanel>
    }
</MudExpansionPanels>

@code {
    /// <summary>An editable placement row (X/Z rotations are kept as they are; the table edits the Y turn).</summary>
    private sealed class Row
    {
        public string Name { get; set; } = "";
        public Guid AssetId { get; set; }
        public Guid? VariantId { get; set; }
        public double[] At { get; set; } = [0, 0, 0];
        public double[] Rot { get; set; } = [0, 0, 0];
        public double Scale { get; set; } = 1;
    }

    [Parameter] public Guid SceneId { get; set; }
    private Scene? _scene;
    private Pack? _pack;
    private List<Asset> _assets = [];
    private List<AssetVariant> _variants = [];
    private List<ProgramVersion> _programs = [];
    private List<Row> _rows = [];
    private Dictionary<(Guid Asset, Guid Variant), Guid?> _versions = [];
    private string _description = "";
    private string _saved = "";
    private bool _building, _deleted;

    /// <summary>The editor differs from the stored scene (unsaved edits are kept when the scene reloads).</summary>
    private bool Dirty => Snapshot() != _saved;

    private string Snapshot() => System.Text.Json.JsonSerializer.Serialize(new
    {
        _description, _rows, versions = _versions.Where(v => v.Value is not null).OrderBy(v => v.Key.Asset).ThenBy(v => v.Key.Variant).Select(v => $"{v.Key.Asset}/{v.Key.Variant}/{v.Value}"),
    });

    protected override async Task LoadAsync()
    {
        if (_deleted) return;
        _scene = await Api.GetAsync<Scene>($"api/scenes/{SceneId}");
        _pack = await Api.GetAsync<Pack>($"api/packs/{_scene.PackId}");
        PageCtx.Set(new ChatContext(ChatPages.Scene, _pack.Id, SceneId: SceneId));
        _assets = await Api.GetAsync<List<Asset>>($"api/packs/{_scene.PackId}/assets");
        _variants = await Api.GetAsync<List<AssetVariant>>($"api/packs/{_scene.PackId}/variants");
        _programs = await Api.GetAsync<List<ProgramVersion>>($"api/packs/{_scene.PackId}/programs");
        _building = (await Api.GetAsync<List<Job>>($"api/jobs?packId={_scene.PackId}&kind={JobKinds.Scene}"))
            .Any(j => j.State is JobState.Queued or JobState.Running && j.Inputs["sceneId"]?.GetValue<Guid>() == SceneId);
        if (_saved.Length > 0 && Dirty) return; // keep the user's unsaved edits
        _description = _scene.Description;
        _rows = _scene.Placements.Select(p => new Row { Name = p.Name, AssetId = p.AssetId, VariantId = p.VariantId, At = [.. p.At], Rot = [.. p.Rot ?? [0, 0, 0]], Scale = p.Scale }).ToList();
        _versions = _scene.Versions.ToDictionary(v => (v.AssetId, v.VariantId), v => v.ProgramVersionId);
        _saved = Snapshot();
    }

    // Asset changes matter too: a new build or current version shows up in the version choices.
    protected override bool Concerns(Guid? packId, Guid? assetId) => !_deleted && packId == _scene?.PackId;

    protected override Task OnJobEventAsync(JobEventMessage e) =>
        e.Kind is JobKinds.Scene or JobKinds.Build && e.Type is not ("progress" or "stream") ? LoadAsync() : Task.CompletedTask;

    private Guid VariantOf(Row row) => row.VariantId ?? _assets.FirstOrDefault(a => a.Id == row.AssetId)?.DefaultVariantId ?? Guid.Empty;

    private IEnumerable<(Guid Asset, Guid Variant)> UsedVariants() => _rows.Select(r => (r.AssetId, VariantOf(r))).Distinct();

    private string CurrentLabel(Guid variantId) =>
        _variants.FirstOrDefault(v => v.Id == variantId)?.CurrentProgramVersionId is { } id && _programs.FirstOrDefault(p => p.Id == id) is { } p
            ? $"current (v{p.Number})" : "current";

    private void SetVersion((Guid, Guid) key, Guid? id)
    {
        if (id is null) _versions.Remove(key);
        else _versions[key] = id;
    }

    private void Add()
    {
        var n = _rows.Count + 1;
        _rows.Add(new Row { Name = $"{_assets[0].Name} {n}", AssetId = _assets[0].Id, At = [n * 1.5, 0, 0] });
    }

    /// <summary>Saves and builds; with no edits, rebuilds the scene from the chosen versions (Refresh).</summary>
    private Task SaveAsync() => Try(async () =>
    {
        var versions = _versions.Where(v => v.Value is not null).Select(v => new SceneVersion(v.Key.Asset, v.Key.Variant, v.Value)).ToList();
        await Api.PutAsync<Scene>($"api/packs/{_scene!.PackId}/scenes", new SceneEdit(_scene.Name, _description,
            _rows.Select(r => new ScenePlacement(r.Name.Trim(), r.AssetId, r.At, r.Rot, r.Scale, r.VariantId)).ToList(), versions));
        _saved = "";
        await LoadAsync();
    });

    private async Task DeleteAsync()
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete scene", $"Delete scene \"{_scene!.Name}\"? The assets stay.", yesText: "Delete", cancelText: "Cancel") != true) return;
        await Try(async () =>
        {
            _deleted = true;
            await Api.DeleteAsync($"api/scenes/{SceneId}");
            Nav.NavigateTo($"/packs/{_scene.PackId}?tab=scenes");
        });
    }
}
