@page "/"
@inherits LiveComponent
@inject PageContext PageCtx
@inject IDialogService Dialogs

<PageTitle>Packs · Slopoly</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h5">Packs</MudText>
    <MudSpacer />
    <MudTextField @bind-Value="_name" Label="New pack name" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                  OnKeyUp="@(e => e.Key == "Enter" ? CreateAsync() : Task.CompletedTask)" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="string.IsNullOrWhiteSpace(_name)" OnClick="CreateAsync">Create</MudButton>
</MudStack>

@if (_packs is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_packs.Count == 0)
{
    <MudAlert Severity="Severity.Info">No packs yet. A pack holds a style guide, palette and assets that belong together.</MudAlert>
}
else
{
    <MudGrid>
        @foreach (var pack in _packs)
        {
            <MudItem xs="12" sm="6" md="4">
                <MudCard Outlined="true" Style="height: 100%">
                    <MudCardContent>
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudLink Href="@($"/packs/{pack.Id}")" Typo="Typo.h6">@pack.Name</MudLink>
                            <MudSpacer />
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" aria-label="@($"{pack.Name} actions")">
                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" OnClick="() => DeleteAsync(pack)">Delete pack…</MudMenuItem>
                            </MudMenu>
                        </MudStack>
                        <MudText Typo="Typo.body2" Class="mt-2 clamp-3">@(string.IsNullOrWhiteSpace(pack.StyleText) ? "No style yet" : pack.StyleText)</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<Pack>? _packs;
    private string _name = "";

    protected override async Task LoadAsync()
    {
        PageCtx.Set(new ChatContext(ChatPages.Home));
        _packs = await Api.GetAsync<List<Pack>>("api/packs");
    }

    private Task DeleteAsync(Pack pack) => Try(async () => { if (await NameDialog.DeletePackAsync(Dialogs, Api, pack)) await LoadAsync(); });

    protected override bool Concerns(Guid? packId, Guid? assetId) => assetId is null;

    private Task CreateAsync() => Try(async () =>
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        await Api.PostAsync<Pack>("api/packs", new PackEdit(_name.Trim(), null, null, null));
        _name = "";
    });
}
