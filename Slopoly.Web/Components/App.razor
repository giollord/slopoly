<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <ImportMap ImportMapDefinition="Map" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script src="@Assets["js/viewer.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = null!;

    /// <summary>three.js (vendored in wwwroot/lib) for the 3D viewer's modules, next to the static asset map.</summary>
    private static readonly ImportMapDefinition Three = new(new Dictionary<string, string>
    {
        ["three"] = "/lib/three-0.170.0/build/three.module.min.js",
        ["three/addons/"] = "/lib/three-0.170.0/examples/jsm/",
    }, null, null);

    private ImportMapDefinition Map =>
        HttpContext.GetEndpoint()?.Metadata.GetMetadata<ImportMapDefinition>() is { } assets ? ImportMapDefinition.Combine(assets, Three) : Three;
}
