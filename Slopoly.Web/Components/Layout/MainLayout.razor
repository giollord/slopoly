@inherits LayoutComponentBase

<MudThemeProvider IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudButton Href="/" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.ViewInAr">Slopoly</MudButton>
        <MudSpacer />
        <MudButton Href="/knowledge" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.MenuBook">Knowledge</MudButton>
        <MudToggleIconButton @bind-Toggled="_dark" Icon="@Icons.Material.Filled.DarkMode" ToggledIcon="@Icons.Material.Filled.LightMode" Color="Color.Inherit" />
    </MudAppBar>
    <MudMainContent Class="pt-14">
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _dark = true;
}
